# Example objective function (modify as needed)
def obj_function_distance(robot_idx, particle):
    # Define how to calculate the distance or cost of a particle's path
    return np.sum(np.linalg.norm(particle[1:] - particle[:-1], axis=1))

def get_next_velocity(velocity, c1, c2, global_best, particles):
    # Update velocity (PSO-specific logic)
    inertia = 0.5 * velocity
    cognitive = c1 * (global_best - particles)
    social = c2 * np.random.uniform(size=particles.shape) * (global_best - particles)
    return inertia + cognitive + social

def get_next_position(particles, velocity, lb, ub):
    # Update particle positions and apply boundary constraints
    particles += velocity
    particles = np.clip(particles, lb, ub)
    return particles

def dijkstra():
    global sp, triangulation, robots, END_XY
    if not triangulation or not robots or not END_XY:
        print("Error: Missing triangulation, robots, or END_XY.")
        return
    sp = []
    for robot in robots:
        start_simplex = triangulation.find_simplex(robot)
        end_simplex = triangulation.find_simplex(END_XY)
        
        # Build the graph
        graph = nx.Graph()
        for simplex in triangulation.simplices:
            for i in range(len(simplex)):
                for j in range(i + 1, len(simplex)):
                    node1, node2 = simplex[i], simplex[j]
                    weight = np.linalg.norm(triangulation.points[node1] - triangulation.points[node2])
                    graph.add_edge(node1, node2, weight=weight)
        
        # Find the shortest path
        shortest_path = nx.shortest_path(graph, source=start_simplex, target=end_simplex, weight='weight')
        sp.append(shortest_path)
    print(f"Shortest paths: {sp}")  # Debug statement


def aco_find_paths(graph, start, end, num_ants=10, iterations=100, alpha=1, beta=2, evaporation=0.5):
    # Initialize pheromone levels
    pheromones = {edge: 1.0 for edge in graph.edges}
    best_path = None
    best_path_length = float('inf')

    for _ in range(iterations):
        paths = []
        path_lengths = []

        # Simulate ants
        for _ in range(num_ants):
            current = start
            path = [current]
            length = 0

            while current != end:
                neighbors = list(graph.neighbors(current))
                if not neighbors:
                    break

                # Calculate probabilities for neighbors
                probabilities = []
                for neighbor in neighbors:
                    edge = (current, neighbor) if (current, neighbor) in graph.edges else (neighbor, current)
                    tau = pheromones[edge] ** alpha
                    eta = (1.0 / graph[current][neighbor]['weight']) ** beta
                    probabilities.append(tau * eta)

                probabilities = np.array(probabilities)
                probabilities /= probabilities.sum()

                # Choose next node based on probabilities
                next_node = np.random.choice(neighbors, p=probabilities)
                path.append(next_node)
                length += graph[current][next_node]['weight']
                current = next_node

            paths.append(path)
            path_lengths.append(length)

        # Update pheromones
        for edge in pheromones:
            pheromones[edge] *= (1 - evaporation)

        for path, length in zip(paths, path_lengths):
            for i in range(len(path) - 1):
                edge = (path[i], path[i+1]) if (path[i], path[i+1]) in graph.edges else (path[i+1], path[i])
                pheromones[edge] += 1.0 / length

        # Track the best path
        min_length = min(path_lengths)
        if min_length < best_path_length:
            best_path_length = min_length
            best_path = paths[np.argmin(path_lengths)]

    return best_path, best_path_length

